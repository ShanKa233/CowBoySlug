<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <DefaultItemExcludes>$(DefaultItemExcludes);Examples/**/*.cs</DefaultItemExcludes>
  </PropertyGroup>

  <!--
    路径配置：
    设置环境变量 RW_PATH 指向 Rain World 安装目录即可跨平台使用。
  -->
  <PropertyGroup>
    <RWPath Condition="'$(RWPath)' == ''">$(RW_PATH)</RWPath>
    <WorkshopPath Condition="'$(WorkshopPath)' == ''">
      $(RW_WORKSHOP_PATH)</WorkshopPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(RWPath)/RainWorld_Data/Managed/*.dll" />
    <Reference Include="$(RWPath)/BepInEx/plugins/*.dll" />
    <Reference Include="$(RWPath)/BepInEx/core/*.dll" />

    <Reference Include="$(RWPath)/BepInEx/utils/*.dll"
      Condition="Exists('$(RWPath)/BepInEx/utils/')" />
  </ItemGroup>

  <!-- MOD 依赖 -->
  <ItemGroup>
    <Reference
      Include="$(WorkshopPath)/2933196558/newest/plugins/SlugBase.dll" />
    <Reference
      Include="$(WorkshopPath)/2920541687/newest/plugins/Fisobs.dll" />
    <Reference
      Include="$(WorkshopPath)/3388224007/plugins/*.dll" /><!-- Meadowmode -->
  </ItemGroup>

  <Target Name="GenerateMod" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <RemovePlugins Include="mod/newest/plugins/*.dll" />
    </ItemGroup>

    <ItemGroup>
      <CopyPlugins Include="$(TargetPath);$(TargetDir)$(TargetName).pdb" />
    </ItemGroup>

    <Delete Files="@(RemovePlugins)" />
    <Copy SourceFiles="@(CopyPlugins)" DestinationFolder="mod/newest/plugins/" />
  </Target>
</Project>